# Database (Vercel Postgres)
POSTGRES_URL=
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_USER=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-key-here-generate-with-openssl-rand-base64-32

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OpenAI (optional - users can provide their own)
OPENAI_API_KEY=

# App URL used as the OAuth redirect base for Strava (and any other OAuth flows).
# Must match the Authorization Callback Domain configured in Strava's API settings.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Strava (required for the Garmin/Strava run-import flow).
# Get these at https://www.strava.com/settings/api
# IMPORTANT: these must be set on Vercel (Project Settings → Environment Variables)
# for production. Missing values cause `Missing env var STRAVA_CLIENT_ID` 500s on
# /api/strava/connect and silent webhook refresh failures after the first 6h.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_VERIFY_TOKEN=
